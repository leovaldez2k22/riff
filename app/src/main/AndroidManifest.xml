<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Feature 10: the phone's own equalizer screen, when it has one. -->
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <application
        android:name=".RiffApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        tools:ignore="MissingIntentFilterForMediaSearch"
        android:usesCleartextTraffic="false">
        <!-- Feature 14: Android Auto lists Riff as a media app. Its voice search reaches the media session
             (CarLibrary.queueFor reads the query), so no activity takes MEDIA_PLAY_FROM_SEARCH: asking the phone's
             Assistant to play in Riff is not built. -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <!-- Feature 19: Cast with Google's Default Media Receiver (RiffCastOptions). -->
        <meta-data android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME" android:value="com.musicglass.personal.RiffCastOptions" />
        <!-- Feature 19: Play services' Cast library reports its own use to Google through Firebase's data transport.
             Its uploader ("cct") is unregistered here, so the transport has nowhere to send and drops the reports on
             the phone. The classes stay: the Cast library refers to them, and R8 refuses a build without them. -->
        <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" android:exported="false">
            <meta-data android:name="backend:com.google.android.datatransport.cct.CctBackendFactory" tools:node="remove" />
        </service>
        <!-- Compose reads LocalConfiguration/LocalDensity and updates in place; recreating the
             activity for these changes rebuilt the whole UI (~280 ms per rotation or theme change).
             Locale is not listed, so a language change still recreates.
             singleTask: a launcher tap on a task first opened from the notification, a widget or
             another app stacked a further MainActivity (40 copies, 710 MB, in a 50k-event monkey
             run on 2026-10-04). The activity reads nothing from its intents. -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Feature 13: YouTube Music and YouTube links. Riff cannot verify these domains, so Android opens them
                 here only after the owner allows it (App info, Open by default); Share always works. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="music.youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="youtube.com" />
                <data android:host="youtu.be" />
            </intent-filter>
            <!-- Feature 27: long-pressing Riff's Quick Settings tile opens Riff. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Exported without a permission on purpose (lint ExportedService, Q15 review): the system, Bluetooth,
             a car and an assistant bind to a media session service, and a permission would lock them out.
             What a caller may do is decided per controller in MusicPlaybackService.onConnect: the app itself
             gets its own commands; Android Auto and the system's controls may also browse (mayBrowse); anyone
             else gets transport and no queue editing. -->
        <service
            android:name=".MusicPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- Feature 14: Android Auto browses through the platform's media browser. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Feature 27: play and pause from Quick Settings. -->
        <service
            android:name=".PlaybackTile"
            android:exported="true"
            android:icon="@drawable/tile_riff"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <!-- QuickJS challenge solving runs here so a native crash can't stop playback. -->
        <service android:name=".SolverService" android:process=":solver" android:exported="false" />
        <service android:name=".OfflineDownloadService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".MoodPhotoRefreshJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
        <service android:name=".OfflineDownloadJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
    <receiver android:name=".CompactRiffWidget" android:exported="false" android:label="@string/widget_compact_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_compact_info" /></receiver>
<receiver android:name=".WideRiffWidget" android:exported="false" android:label="@string/widget_wide_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_wide_info" /></receiver>
<receiver android:name=".ArtworkRiffWidget" android:exported="false" android:label="@string/widget_artwork_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_artwork_info" /></receiver>
<receiver android:name=".PlayerRiffWidget" android:exported="false" android:label="@string/widget_player_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_player_info" /></receiver>
<receiver android:name=".LargeRiffWidget" android:exported="false" android:label="@string/widget_large_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_large_info" /></receiver>
<receiver android:name=".CircleRiffWidget" android:exported="false" android:label="@string/widget_circle_name"><intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter><meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_circle_info" /></receiver>
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/shared_files" />
        </provider>
    </application>
</manifest>
