<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Feature 24: the camera scans a friend's blend code, asked for only when Scan is pressed. Riff+ still installs on a
         phone without a camera; that phone shows its code and the friend scans it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- As in main: Android Auto search uses the media session; no activity accepts Assistant search. -->
    <application tools:ignore="MissingIntentFilterForMediaSearch">
        <!-- Plus bundles ONNX Runtime; its automatic telemetry initializer must never run. -->
        <provider android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer" tools:node="remove" />
        <!-- Feature 21: Riff+'s launcher entry is one of the aliases below (the listener's icon), so MainActivity keeps its
             links, shortcuts and shares but not its own launcher entry. Riff's manifest keeps it, so a phone switched
             back to Riff has a working icon before Riff first runs. -->
        <activity android:name=".MainActivity">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- appearance aliases: generated -->
        <activity-alias android:name=".LauncherARose" android:targetActivity=".MainActivity"
            android:enabled="true" android:exported="true" android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_a_rose" android:roundIcon="@mipmap/ic_launcher_a_rose">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherAViolet" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_a_violet" android:roundIcon="@mipmap/ic_launcher_a_violet">
