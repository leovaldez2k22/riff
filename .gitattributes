# Scoped on purpose: only files that must keep Unix line endings on every platform.
gradlew text eol=lf
*.sh text eol=lf
# Test fixtures whose bytes are checked against recorded digests (ProviderFixtureTest): a CRLF checkout
# (core.autocrlf=true) would change them and fail the test on a fresh Windows clone.
app/src/test/resources/quality/**/*.json text eol=lf
app/src/androidTest/assets/quality/**/*.json text eol=lf
